# Required for AI food estimation and workout suggestions.
# Without this, the app still works for manual logging.
ANTHROPIC_API_KEY=

# Optional: override the model used for AI features.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# PIN required (via the x-app-pin header) to use "Estimate with AI".
# Set this in your deployment environment — do not put the real value here.
ESTIMATE_PIN=
